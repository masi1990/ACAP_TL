// ACAP–TL hub schema (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MemberState {
  id           String         @id
  iso2         String         @unique
  name         String
  /// NORTH | WEST | CENTRAL | EAST | SOUTHERN
  region       String         @default("")
  organizations Organization[]
  entryPoints  EntryPoint[]
  nationalRules NationalRule[]
  recMemberships MemberStateRec[]
  institutionRequests InstitutionRequest[]
  standardAdoptions StandardAdoption[]
  organizationCountries OrganizationCountry[]
  companyCountries CompanyCountry[]
  libraryAccess LibraryAccess[]
  libraryAccessRequests LibraryAccessRequest[]
  libraryStandardRequests LibraryStandardRequest[]
  libraryReleases LibraryRelease[]
}

model Rec {
  id          String       @id
  code        String       @unique
  name        String
  tariffLines TariffLine[]
  memberStates MemberStateRec[]
}

/// A country may belong to more than one REC. Membership sits on the country, not on each authority.
model MemberStateRec {
  memberStateId String
  recId         String
  memberState   MemberState @relation(fields: [memberStateId], references: [id], onDelete: Cascade)
  rec           Rec         @relation(fields: [recId], references: [id], onDelete: Cascade)

  @@id([memberStateId, recId])
}

model Organization {
  id             String                   @id @default(cuid())
  name           String
  type           String // ARSO | CB | NSB | REGULATOR | CUSTOMS | MARKET_SURVEILLANCE | ENTRY_POINT_OP | MANUFACTURER | IMPORTER | CLIENT
  memberStateId  String?
  memberState    MemberState?             @relation(fields: [memberStateId], references: [id])
  primaryAdminId String?
  /// Accreditation body, for example KENAS, SADCAS, or EGAC.
  accreditationBody String                @default("")
  /// Accreditation reference, for example an ISO/IEC 17065 number.
  accreditationRef  String                @default("")
  contactEmail      String                @default("")
  contactPhone      String                @default("")
  addressLine       String                @default("")
  website           String                @default("")
  /// GOVERNMENT | PRIVATE. A national standards body is always GOVERNMENT.
  backing           String                @default("GOVERNMENT")
  /// Only a national standards body may also certify. A certification body cannot set this.
  alsoCertifies     Boolean               @default(false)
  /// ACTIVE | SUSPENDED | PENDING | REJECTED
  status            String                @default("ACTIVE")
  createdAt      DateTime                 @default(now())
  operatingCountries OrganizationCountry[]
  libraryAccess  LibraryAccess[]
  libraryAccessRequests LibraryAccessRequest[]
  libraryStandardRequests LibraryStandardRequest[]
  libraryReleases LibraryRelease[]
  staffPostings  StaffPosting[]
  libraryActivities LibraryActivity[]
  memberships    OrganizationMembership[]
  entryPoints    EntryPoint[]
  cbLicenses     CbLicense[]
  clientAccounts ClientAccount[]
  markSublicenses MarkSublicense[]        @relation("IssuerOrg")
  complaintsRouted ConsumerComplaint[]    @relation("RoutedCb")
  applications   CertificationApplication[]
  inspections    ConformityInspection[]
  clearances     CustomsClearance[]
  servicingCbId  String?
  servicingCb    Organization?  @relation("CbClients", fields: [servicingCbId], references: [id])
  clients        Organization[] @relation("CbClients")
  certifiedProducts Product[]   @relation("ProductCertifyingCb")
  importedAsManufacturer ImportedCertifiedMark[] @relation("ImportedMarkManufacturer")
  importedAsCertificationBody ImportedCertifiedMark[] @relation("ImportedMarkCb")
}

model UserAccount {
  id              String                   @id @default(cuid())
  email           String                   @unique
  name            String
  passwordHash    String
  emailVerified   Boolean                  @default(false)
  locale          String                   @default("en")
  /// Legacy comma-separated global roles (kept in sync with UserRoleAssignment for GLOBAL scope)
  rolesGlobal     String                   @default("")
  createdAt       DateTime                 @default(now())
  mustChangePassword Boolean               @default(false)
  lastActiveAt    DateTime                 @default(now())
  memberships     OrganizationMembership[]
  institutionRequests InstitutionRequest[]
  passwordResets  PasswordReset[]
  sessions        Session[]
  invitationsSent Invitation[]             @relation("InvitedBy")
  roleAssignments UserRoleAssignment[]
  recordedApplications CertificationApplication[] @relation("ApplicationRecorder")
  recordedAssessmentItems AssessmentItem[] @relation("ItemRecorder")
  libraryAccess LibraryAccess[]
  libraryAccessRequests LibraryAccessRequest[]
  staffPostings StaffPosting[]
  libraryActivities LibraryActivity[]
  libraryReleases LibraryRelease[]
}

/// Canonical RBAC role catalogue (system + custom). Permissions are least-privilege sets.
model RoleDefinition {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  description      String               @default("")
  scope            String               // GLOBAL | ORG
  permissionsJson  String               // JSON string[] of Permission codes
  isSystem         Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  assignments      UserRoleAssignment[]
}

model UserRoleAssignment {
  id             String         @id @default(cuid())
  userId         String
  user           UserAccount    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleCode       String
  role           RoleDefinition @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  organizationId String? // required for ORG-scoped roles; null for GLOBAL
  grantedAt      DateTime       @default(now())
  grantedById    String?

  @@unique([userId, roleCode, organizationId])
  @@index([userId])
  @@index([roleCode])
}

/// A manufacturer asks to become an institution. The manufacturer company stays; approval adds a new organisation on the same login.
model InstitutionRequest {
  id             String      @id @default(cuid())
  userId         String
  user           UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String
  memberStateId  String
  memberState    MemberState @relation(fields: [memberStateId], references: [id])
  /// PENDING | APPROVED | REJECTED
  status         String      @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  organizationId String?
  createdAt      DateTime    @default(now())

  @@index([userId, status])
}

model PasswordReset {
  id        String      @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([userId])
}

/// Countries where a private certification body operates. A government body keeps one home country on Organization.memberStateId.
model OrganizationCountry {
  organizationId String
  memberStateId  String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberState    MemberState  @relation(fields: [memberStateId], references: [id], onDelete: Cascade)

  @@id([organizationId, memberStateId])
  @@index([memberStateId])
}

/// Countries where a company operates. Company.countryIso2 stays the country of registration.
model CompanyCountry {
  companyId     String
  memberStateId String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberState   MemberState @relation(fields: [memberStateId], references: [id], onDelete: Cascade)

  @@id([companyId, memberStateId])
  @@index([memberStateId])
}

/// Standards-officer access for harmonisation and adoption. FULL is every published standard. RELEASE is only standards an admin has sent.
model LibraryAccess {
  id             String       @id @default(cuid())
  userId         String
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberStateId  String
  memberState    MemberState  @relation(fields: [memberStateId], references: [id])
  /// FULL | RELEASE
  scope          String
  grantedById    String?
  grantedAt      DateTime     @default(now())

  @@unique([userId, organizationId, memberStateId])
  @@index([userId])
  @@index([organizationId])
}

/// A person asks to be a standards officer at an institution and country.
model LibraryAccessRequest {
  id             String       @id @default(cuid())
  userId         String
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  memberStateId  String
  memberState    MemberState  @relation(fields: [memberStateId], references: [id])
  /// PENDING | APPROVED | REJECTED
  status         String       @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, status])
  @@index([status])
}

/// A request for particular African standards, from a signed-in officer or an email that may not have an account yet.
model LibraryStandardRequest {
  id             String                       @id @default(cuid())
  email          String
  name           String
  userId         String?
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id])
  memberStateId  String
  memberState    MemberState                  @relation(fields: [memberStateId], references: [id])
  note           String                       @default("")
  /// PENDING | SENT | REJECTED
  status         String                       @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime                     @default(now())
  items          LibraryStandardRequestItem[]
  releases       LibraryRelease[]

  @@index([status])
  @@index([email])
}

model LibraryStandardRequestItem {
  id        String                 @id @default(cuid())
  requestId String
  request   LibraryStandardRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  standardId String
  standard  Standard               @relation(fields: [standardId], references: [id])

  @@unique([requestId, standardId])
}

/// An email of selected standards. The token opens account creation or sign-in. It does not serve the PDF.
model LibraryRelease {
  id             String               @id @default(cuid())
  email          String
  token          String               @unique
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  memberStateId  String
  memberState    MemberState          @relation(fields: [memberStateId], references: [id])
  userId         String?
  user           UserAccount?         @relation(fields: [userId], references: [id])
  requestId      String?
  request        LibraryStandardRequest? @relation(fields: [requestId], references: [id])
  sentAt         DateTime             @default(now())
  items          LibraryReleaseItem[]

  @@index([email])
  @@index([userId])
}

model LibraryReleaseItem {
  id         String         @id @default(cuid())
  releaseId  String
  release    LibraryRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  standardId String
  standard   Standard       @relation(fields: [standardId], references: [id])

  @@unique([releaseId, standardId])
}

/// Where a staff member is posted. The institution's home country does not change.
model StaffPosting {
  id             String        @id @default(cuid())
  userId         String
  user           UserAccount   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// REGIONAL | BORDER | FOREIGN
  kind           String
  officeName     String        @default("")
  entryPointId   String?
  entryPoint     EntryPoint?   @relation(fields: [entryPointId], references: [id])
  /// ISO country of the post. A foreign post need not be an African Union member.
  countryIso2    String
  createdAt      DateTime      @default(now())
  activities     LibraryActivity[]

  @@index([userId, organizationId])
  @@index([entryPointId])
}

model LibraryActivity {
  id             String        @id @default(cuid())
  occurredAt     DateTime      @default(now())
  userId         String?
  user           UserAccount?  @relation(fields: [userId], references: [id])
  roleCode       String        @default("")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  memberStateId  String?
  postingId      String?
  posting        StaffPosting? @relation(fields: [postingId], references: [id])
  action         String
  standardId     String?
  standard       Standard?     @relation(fields: [standardId], references: [id])
  language       String        @default("")
  detail         String        @default("")

  @@index([userId, occurredAt])
  @@index([action])
  @@index([organizationId])
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String // PRIMARY_ADMIN | ORG_ADMIN | ORG_USER | CB_OFFICER | CUSTOMS_OFFICER
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           UserAccount  @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model Invitation {
  id             String      @id @default(cuid())
  organizationId String
  email          String
  role           String
  token          String      @unique
  invitedById    String
  invitedBy      UserAccount @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedAt     DateTime?
  createdAt      DateTime    @default(now())
  expiresAt      DateTime
}

model Session {
  id               String      @id @default(cuid())
  userId           String
  user             UserAccount @relation(fields: [userId], references: [id])
  token            String      @unique
  createdAt        DateTime    @default(now())
  lastActivityAt   DateTime    @default(now())
  expiresAt        DateTime
  impersonatorId   String?
  impersonationReason String?
}

model EntryPoint {
  id             String        @id @default(cuid())
  name           String
  code           String        @unique
  kind           String // BORDER | PORT | AIRPORT | INLAND
  memberStateId  String
  memberState    MemberState   @relation(fields: [memberStateId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  locationNote   String?
  staffPostings  StaffPosting[]
}

/// A sector groups technical committees. A committee belongs to one sector.
model Sector {
  id         String               @id @default(cuid())
  code       String               @unique
  name       String
  createdAt  DateTime             @default(now())
  committees TechnicalCommittee[]
}

/// A technical committee belongs to one sector and owns many standards.
model TechnicalCommittee {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  sectorId  String
  sector    Sector     @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  standards Standard[]
  createdAt DateTime   @default(now())

  @@index([sectorId])
}

model Standard {
  id                   String               @id
  designation          String               @unique
  titleEn              String
  titleFr              String?
  titlePt              String?
  titleAr              String?
  ics                  String
  publisher            String               @default("ARSO")
  /// PRODUCT | SERVICE | TESTING | REFERENCE
  kind                 String               @default("PRODUCT")
  technicalCommitteeId String?
  technicalCommittee   TechnicalCommittee?  @relation(fields: [technicalCommitteeId], references: [id], onDelete: Restrict)
  versions             StandardVersion[]
  adoptions            StandardAdoption[]
  libraryRequestItems  LibraryStandardRequestItem[]
  libraryReleaseItems  LibraryReleaseItem[]
  libraryActivities    LibraryActivity[]

  @@index([kind])
  @@index([technicalCommitteeId])
}

/// Countries that have adopted this standard. Rate is adopters / all member states.
model StandardAdoption {
  standardId    String
  memberStateId String
  standard      Standard    @relation(fields: [standardId], references: [id], onDelete: Cascade)
  memberState   MemberState @relation(fields: [memberStateId], references: [id], onDelete: Cascade)

  @@id([standardId, memberStateId])
  @@index([memberStateId])
}

model StandardVersion {
  id                   String              @id
  standardId           String
  standard             Standard            @relation(fields: [standardId], references: [id])
  editionLabel         String
  year                 Int
  effectiveFrom        DateTime
  publicationStatus    String
  authoritativeLocale  String              @default("en")
  sourcePdfUri         String?
  contentHash          String
  scopeEn              String
  machineDocJson       String // full machine-readable pack JSON
  requirementsJson     String // requirements array JSON
  normativeRefsJson    String
  packagingJson        String?
  labellingJson        String?
  samplingJson         String?
  tariffMaps           StandardTariffMap[]
  nationalRules        NationalRuleLink[]
  catalogItem          CatalogItem?
  productLinks         ProductStandardLink[]
  applications         CertificationApplication[]
  inspections          ConformityInspection[]
  languageFiles        StandardLanguageFile[]
  importedMarks        ImportedCertifiedMark[]
}

/// One published PDF for a language of a standard version.
model StandardLanguageFile {
  id                String          @id @default(cuid())
  standardVersionId String
  standardVersion   StandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)
  /// en | fr | pt | ar
  locale            String
  sourcePdfUri      String
  createdAt         DateTime        @default(now())

  @@unique([standardVersionId, locale])
  @@index([standardVersionId])
}

model TariffLine {
  id                 String              @id
  recId              String
  rec                Rec                 @relation(fields: [recId], references: [id])
  codeDisplay        String
  codeNormalized     String
  codeLength         Int
  parentTariffLineId String?
  parent             TariffLine?         @relation("TariffParent", fields: [parentTariffLineId], references: [id])
  children           TariffLine[]        @relation("TariffParent")
  hsHeading          String
  description        String
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  maps               StandardTariffMap[]
  products           Product[]

  @@unique([recId, codeNormalized, effectiveFrom])
}

model StandardTariffMap {
  id                String          @id
  standardVersionId String
  standardVersion   StandardVersion @relation(fields: [standardVersionId], references: [id])
  tariffLineId      String
  tariffLine        TariffLine      @relation(fields: [tariffLineId], references: [id])
  mappingEffect     String          @default("include")
  overrideMode      String?
  effectiveFrom     DateTime
  notes             String?

  @@unique([standardVersionId, tariffLineId])
}

model NationalRule {
  id            String             @id @default(cuid())
  memberStateId String
  memberState   MemberState        @relation(fields: [memberStateId], references: [id])
  title         String
  reference     String
  summary       String
  effectiveFrom DateTime
  links         NationalRuleLink[]
}

model NationalRuleLink {
  id                String          @id @default(cuid())
  nationalRuleId    String
  nationalRule      NationalRule    @relation(fields: [nationalRuleId], references: [id])
  standardVersionId String
  standardVersion   StandardVersion @relation(fields: [standardVersionId], references: [id])
}

model CbLicense {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  licenseType      String // TYPE1_QUALITY | TYPE1_ECO | TYPE2
  markScheme       String // QUALITY | ECO
  status           String // PENDING | APPROVED | SUSPENDED | EXPIRED | WITHDRAWN
  approvalMode     String? // AUTO | MANUAL | HYBRID — for Type2
  issuedAt         DateTime?
  expiresAt        DateTime?
  graceUntil       DateTime? // 2yr grace for Type1 renewals
  parentLicenseId  String?
  parentLicense    CbLicense?      @relation("Type2Parent", fields: [parentLicenseId], references: [id])
  childLicenses    CbLicense[]     @relation("Type2Parent")
  pdfUri           String?
  licenseNumber    String          @unique
  sublicenses      MarkSublicense[]
  createdAt        DateTime        @default(now())
}

model MarkSublicense {
  id             String       @id @default(cuid())
  cbLicenseId    String
  cbLicense      CbLicense    @relation(fields: [cbLicenseId], references: [id])
  issuerOrgId    String
  issuerOrg      Organization @relation("IssuerOrg", fields: [issuerOrgId], references: [id])
  clientName     String
  markScheme     String
  status         String
  approvalMode   String
  issuedAt       DateTime?
  expiresAt      DateTime?
  pdfUri         String?
  licenseNumber  String       @unique
  createdAt      DateTime     @default(now())
}

model ClientAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  displayName    String
  companies      Company[]
}

model Company {
  id              String        @id @default(cuid())
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id])
  legalName       String
  countryIso2     String
  products        Product[]
  operatingCountries CompanyCountry[]
}

model Product {
  id                 String                 @id @default(cuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id])
  name               String
  commodity          String
  tariffLineId       String?
  tariffLine         TariffLine?            @relation(fields: [tariffLineId], references: [id])
  originClaimJson    String? // RulesOfOriginClaim
  certifyingCbId     String?
  certifyingCb       Organization?          @relation("ProductCertifyingCb", fields: [certifyingCbId], references: [id])
  variants           ProductVariant[]
  standardLinks      ProductStandardLink[]
  applications       CertificationApplication[]
  inspections        ConformityInspection[]
  clearances         CustomsClearance[]
}

model ProductStandardLink {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  markScheme        String // QUALITY | ECO
  standardVersionId String
  standardVersion   StandardVersion @relation(fields: [standardVersionId], references: [id])

  @@unique([productId, markScheme])
}

model ProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  sku       String
  grade     String?
  label     String
  pin       ProductPin?
}

model ProductPin {
  id               String              @id @default(cuid())
  variantId        String              @unique
  variant          ProductVariant      @relation(fields: [variantId], references: [id])
  pinCode          String              @unique
  qrPayload        String
  status           String // certified | expired | suspended | withdrawn
  cocId            String?
  coc              CoC?                @relation(fields: [cocId], references: [id])
  issuedAt         DateTime?
  expiresAt        DateTime?
  fraudAlerts      FraudAlert[]
  surveillanceCases SurveillanceCase[]
  complaints       ConsumerComplaint[]
}

model CertificationApplication {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  organizationId    String // CB
  organization      Organization    @relation(fields: [organizationId], references: [id])
  standardVersionId String
  standardVersion   StandardVersion @relation(fields: [standardVersionId], references: [id])
  status            String // DRAFT | PENDING_APPROVAL | EVALUATION | REVIEW | DECISION | CERTIFIED | REJECTED | WITHDRAWN
  markScheme        String // QUALITY | ECO
  qualityApprovedAt DateTime?
  ecoApprovedAt     DateTime?
  recordedById      String?
  recordedBy        UserAccount? @relation("ApplicationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  labResults        LabResult[]
  attachments       Attachment[]
  coc               CoC?
  idempotencyKey    String?         @unique
  assessmentItems   AssessmentItem[]
  testDossier       TestDossier?
  dossierAttachments DossierAttachment[]

  @@unique([productId, markScheme])
}

/// Laboratory and sample for one product and one standard. The certificate reads this row.
model TestDossier {
  id                String                   @id @default(cuid())
  applicationId     String                   @unique
  application       CertificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  laboratoryName    String                   @default("")
  accreditationRef  String                   @default("")
  reportNo          String                   @default("")
  sampleCode        String                   @default("")
  batchOrLot        String                   @default("")
  sampleDescription String                   @default("")
  sampledAt         DateTime?
  testedAt          DateTime?
}

/// One ARSO-CERT annex, or an extra file the officer adds. Annex codes are unique per application.
model DossierAttachment {
  id            String                   @id @default(cuid())
  applicationId String
  application   CertificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String // ANNEX | OTHER
  annexCode     String?
  title         String                   @default("")
  filename      String
  contentType   String
  storageUri    String
  uploadedAt    DateTime                 @default(now())

  @@unique([applicationId, annexCode])
  @@index([applicationId])
}

/// One row of the standard, a national regulation, or an extra requirement.
model AssessmentItem {
  id             String                   @id @default(cuid())
  applicationId  String
  application    CertificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  source         String // STANDARD | NATIONAL | OTHER
  kind           String                   @default("clause") // clause | table
  itemKey        String
  section        String                   @default("")
  clause         String                   @default("")
  heading        String                   @default("")
  text           String
  testMethod     String                   @default("")
  countryIso2    String?
  pass           Boolean?
  measuredValue  String                   @default("")
  unit           String                   @default("")
  notes          String                   @default("")
  sortOrder      Int                      @default(0)
  recordedById   String?
  recordedBy     UserAccount?             @relation("ItemRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  evidence       LabEvidence[]

  @@unique([applicationId, itemKey])
}

model LabEvidence {
  id               String         @id @default(cuid())
  assessmentItemId String
  assessmentItem   AssessmentItem @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)
  filename         String
  contentType      String
  storageUri       String
  uploadedAt       DateTime       @default(now())
}

model LabResult {
  id             String                    @id @default(cuid())
  applicationId  String                    @unique
  application    CertificationApplication  @relation(fields: [applicationId], references: [id])
  requirementId  String
  measuredValue  String
  unit           String
  pass           Boolean
  labName        String
  testedAt       DateTime
  notes          String?
}

model Attachment {
  id            String                   @id @default(cuid())
  applicationId String
  application   CertificationApplication @relation(fields: [applicationId], references: [id])
  filename      String
  contentType   String
  storageUri    String
  uploadedAt    DateTime                 @default(now())
}

model CoC {
  id             String                   @id @default(cuid())
  applicationId  String                   @unique
  application    CertificationApplication @relation(fields: [applicationId], references: [id])
  certificateNo  String                   @unique
  status         String // certified | expired | suspended | withdrawn | cancelled
  issuedAt       DateTime
  expiresAt      DateTime
  markScheme     String
  pins           ProductPin[]
  markGrants     MarkGrant[]
  ledgerAnchors  LedgerAnchor[]
  feeEvents      FeeEvent[]
  notifications  NotificationJob[]
  clearances     CustomsClearance[]
}

model MarkGrant {
  id        String   @id @default(cuid())
  cocId     String
  coc       CoC      @relation(fields: [cocId], references: [id])
  markScheme String
  status    String
  grantedAt DateTime
}

model LedgerAnchor {
  id         String   @id @default(cuid())
  cocId      String?
  coc        CoC?     @relation(fields: [cocId], references: [id])
  eventType  String
  payloadHash String
  chainId    String   @default("stub-acap-ledger")
  blockRef   String?
  anchoredAt DateTime @default(now())
  entityRef  String?
}

model FeeEvent {
  id     String @id @default(cuid())
  cocId  String
  coc    CoC    @relation(fields: [cocId], references: [id])
  amount Float
  currency String @default("USD")
  kind   String
  createdAt DateTime @default(now())
}

model NotificationJob {
  id           String    @id @default(cuid())
  cocId        String?
  coc          CoC?      @relation(fields: [cocId], references: [id])
  kind         String
  monthsOut    Int?
  entityType   String?
  entityId     String?
  payloadJson  String    @default("{}")
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("PENDING") // PENDING | SENT | FAILED
  attempts     Int       @default(0)
  lastError    String?
  dedupeKey    String    @unique

  @@index([status, scheduledFor])
}

model AuditEvent {
  id               String   @id @default(cuid())
  occurredAt       DateTime @default(now())
  actorUserId      String?
  impersonatorId   String?
  action           String
  entityType       String
  entityId         String
  organizationId   String?
  beforeJson       String?
  afterJson        String?
  reason           String?
  ipHint           String?
  prevHash         String?
  eventHash        String
}

model CatalogItem {
  id                String          @id @default(cuid())
  standardVersionId String          @unique
  standardVersion   StandardVersion @relation(fields: [standardVersionId], references: [id])
  priceCents        Int
  currency          String          @default("USD")
  /// PAID | FREE_VIEW | FREE_DOWNLOAD
  distribution      String          @default("PAID")
  coverTitle        String
  previewScopeOnly  Boolean         @default(true)
  active            Boolean         @default(true)
  orderLines        OrderLine[]
}

model Order {
  id           String            @id @default(cuid())
  buyerEmail   String
  buyerName    String
  buyerPhone   String?
  status       String // CART | CHECKOUT | PAID | FULFILLED | FAILED
  totalCents   Int               @default(0)
  currency     String            @default("USD")
  locale       String            @default("en")
  createdAt    DateTime          @default(now())
  lines        OrderLine[]
  payments     PaymentAttempt[]
  entitlements StandardEntitlement[]
}

model OrderLine {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id])
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  unitPriceCents Int
  qty           Int         @default(1)
  /// Language edition purchased. Separate from Order.locale, which is the buyer's site language.
  editionLocale String      @default("en")
}

model PaymentAttempt {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  provider         String // PESAPAL
  providerRef      String?
  amountCents      Int
  currency         String
  status           String // INITIATED | CONFIRMED | FAILED
  confirmationCode String?
  paymentMethod    String?
  statusDetail     String?
  /// Pesapal status payload. Card numbers are never included.
  rawJson          String?
  createdAt        DateTime @default(now())
  confirmedAt      DateTime?

  @@index([providerRef])
}

/// Pesapal IPN id registered for this environment, so checkout does not depend on a restart.
model PesapalNotification {
  id              String   @id @default(cuid())
  environment     String
  notificationUrl String
  notificationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([environment, notificationUrl])
}

model StandardEntitlement {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  buyerEmail  String
  catalogItemId String
  /// Language edition of this download. One row per order, standard, and language.
  editionLocale String  @default("en")
  grantedAt   DateTime @default(now())
  artifactUri String?
  watermarkText String?

  @@unique([orderId, catalogItemId, editionLocale])
}

model WebhookOutbox {
  id          String    @id @default(cuid())
  eventType   String
  payloadJson String
  targetHint  String? // EAC | ECOWAS | COMESA | NSW
  status      String    @default("PENDING") // PENDING | DELIVERED | FAILED
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  attempts    Int       @default(0)
}

model OfflineCacheProfile {
  id          String   @id @default(cuid())
  entryPointCode String
  pinCode     String
  statusJson  String
  asOf        DateTime
  signature   String
  createdAt   DateTime @default(now())
}

model SurveillanceCase {
  id          String     @id @default(cuid())
  pinId       String?
  pin         ProductPin? @relation(fields: [pinId], references: [id])
  title       String
  status      String // OPEN | INVESTIGATING | SANCTIONED | CLOSED
  summary     String
  createdAt   DateTime   @default(now())
  sanctions   Sanction[]
}

model Sanction {
  id        String           @id @default(cuid())
  caseId    String
  case      SurveillanceCase @relation(fields: [caseId], references: [id])
  level     String // WARNING | SUSPEND_PIN | SUSPEND_COC | WITHDRAW | MARK_MISUSE
  cascadesTo String? // PIN | COC | MARKS
  appliedAt DateTime         @default(now())
  notes     String?
}

/// One conformity check of a product against its single linked standard.
model ConformityInspection {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  standardVersionId String
  standardVersion   StandardVersion @relation(fields: [standardVersionId], references: [id])
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
  inspectorUserId   String?
  result            String // CONFORM | NON_CONFORM
  findings          String          @default("")
  inspectedAt       DateTime        @default(now())
}

/// Customs decision to allow, hold, or refuse a product entering one country from another.
model CustomsClearance {
  id              String        @id @default(cuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  cocId           String?
  coc             CoC?          @relation(fields: [cocId], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  officerUserId   String?
  originIso2      String
  destinationIso2 String
  decision        String // ALLOW | REFUSE | HOLD
  reason          String        @default("")
  decidedAt       DateTime      @default(now())
}

model ConsumerComplaint {
  id             String        @id @default(cuid())
  pinId          String?
  pin            ProductPin?   @relation(fields: [pinId], references: [id])
  complainantEmail String
  subject        String
  body           String
  status         String        @default("OPEN")
  routedCbId     String?
  routedCb       Organization? @relation("RoutedCb", fields: [routedCbId], references: [id])
  createdAt      DateTime      @default(now())
}

model FraudAlert {
  id        String     @id @default(cuid())
  pinId     String?
  pin       ProductPin? @relation(fields: [pinId], references: [id])
  kind      String // MARK_MISUSE | COUNTERFEIT | SUSPICIOUS_VERIFY
  message   String
  status    String     @default("OPEN")
  createdAt DateTime   @default(now())
}

model MetricSnapshot {
  id        String   @id @default(cuid())
  key       String
  value     Float
  labelsJson String?
  takenAt   DateTime @default(now())
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(0)
  windowStart DateTime @default(now())
}

/// One mark copied from the live printing system. The standard link stays empty until someone sets it here.
model ImportedCertifiedMark {
  id                 String                   @id @default(cuid())
  liveProductId      String
  livePinId          String                   @unique
  certificationId    String
  pinText            String                   @unique
  shortId            String?                  @unique
  qrUrl              String
  /// quality | eco
  markType           String
  productName        String
  brand              String                   @default("")
  companyName        String                   @default("")
  country            String                   @default("")
  cbName             String                   @default("")
  markStatus         String
  sourceStandardText String                   @default("")
  issuedAt           DateTime?
  expiresAt          DateTime?
  standardVersionId  String?
  standardVersion    StandardVersion?         @relation(fields: [standardVersionId], references: [id], onDelete: SetNull)
  manufacturerOrgId  String?
  manufacturerOrg    Organization?            @relation("ImportedMarkManufacturer", fields: [manufacturerOrgId], references: [id], onDelete: SetNull)
  certificationBodyOrgId String?
  certificationBodyOrg   Organization?        @relation("ImportedMarkCb", fields: [certificationBodyOrgId], references: [id], onDelete: SetNull)
  importedAt         DateTime                 @default(now())
  portalDecisions    ProductPortalDecision[]
  relistRequests     PortalRelistRequest[]

  @@index([liveProductId])
  @@index([cbName])
  @@index([standardVersionId])
  @@index([manufacturerOrgId])
  @@index([certificationBodyOrgId])
  @@map("imported_certified_marks")
}

/// Append-only. The latest row for a PIN is whether that mark is on this hub's public registry.
model ProductPortalDecision {
  id            String                @id @default(cuid())
  pinText       String
  mark          ImportedCertifiedMark @relation(fields: [pinText], references: [pinText], onDelete: Cascade)
  liveProductId String
  cbName        String                @default("")
  /// listed | removed
  status        String
  reason        String                @default("")
  decidedById   String?
  decidedAt     DateTime              @default(now())

  @@index([pinText, decidedAt])
  @@map("product_portal_decisions")
}

/// A certification body asks ARSO to list a removed mark again. Only ARSO can approve it.
model PortalRelistRequest {
  id          String                @id @default(cuid())
  pinText     String
  mark        ImportedCertifiedMark @relation(fields: [pinText], references: [pinText], onDelete: Cascade)
  cbName      String                @default("")
  requesterId String
  reason      String
  /// pending | approved | rejected
  status      String                @default("pending")
  arsoNote    String                @default("")
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())

  @@index([pinText, status])
  @@map("portal_relist_requests")
}

model PortfolioTransfer {
  id           String   @id @default(cuid())
  fromClientId String
  toClientId   String
  productIdsJson String
  status       String   @default("STUB_PENDING")
  reason       String?
  createdAt    DateTime @default(now())
}
