{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arso-oran.org/schemas/ars-464-2022/machine-standard.schema.json",
  "title": "ARS 464:2022 Machine-Readable Standard Pack",
  "description": "JSON Schema for a machine-readable encoding of ARS 464:2022 Milled rice — Specification, focusing on metadata, normative references, Table 1 grade requirements, packaging/labelling hooks, and sampling. The published PDF remains the legal source of truth until ARSO formally adopts the machine form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "standard",
    "version",
    "locales",
    "normativeReferences",
    "requirements",
    "packaging",
    "labelling",
    "sampling",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designation", "title", "ics", "publisher", "documentType"],
      "properties": {
        "designation": {
          "type": "string",
          "const": "ARS 464"
        },
        "title": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "required": ["en"],
          "properties": {
            "en": { "type": "string" },
            "fr": { "type": "string" },
            "pt": { "type": "string" },
            "ar": { "type": "string" }
          }
        },
        "ics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{3}$" },
          "minItems": 1
        },
        "technicalCommittee": { "type": "string" },
        "publisher": { "type": "string", "const": "ARSO" },
        "documentType": {
          "type": "string",
          "enum": ["AfricanStandard"]
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "editionLabel",
        "effectiveFrom",
        "publicationStatus",
        "authoritativeLocale",
        "sourcePdfUri"
      ],
      "properties": {
        "year": { "type": "integer", "const": 2022 },
        "editionLabel": { "type": "string", "const": "ARS 464:2022" },
        "effectiveFrom": { "type": "string", "format": "date" },
        "supersedes": {
          "type": ["string", "null"],
          "description": "Prior edition designation if any"
        },
        "publicationStatus": {
          "type": "string",
          "enum": ["draft", "published", "superseded", "withdrawn"]
        },
        "authoritativeLocale": {
          "type": "string",
          "enum": ["en", "fr", "pt", "ar"]
        },
        "sourcePdfUri": {
          "type": "string",
          "format": "uri"
        },
        "legalDualFormNote": {
          "type": "string",
          "description": "PDF remains authoritative until machine form is formally adopted"
        }
      }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "translationStatus"],
        "properties": {
          "locale": { "type": "string", "enum": ["en", "fr", "pt", "ar"] },
          "translationStatus": {
            "type": "string",
            "enum": ["authoritative", "validated", "draft", "missing"]
          },
          "pdfMasterUri": { "type": ["string", "null"], "format": "uri" },
          "previewUri": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "Cover + Scope preview only; never the full master"
          },
          "machineDocUri": { "type": ["string", "null"], "format": "uri" },
          "rtl": { "type": "boolean", "default": false }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "commodity": { "type": "string" },
        "species": {
          "type": "array",
          "items": { "type": "string" }
        },
        "intendedUse": { "type": "string" }
      }
    },
    "normativeReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "designation", "title", "role"],
        "properties": {
          "id": { "type": "string" },
          "designation": { "type": "string" },
          "title": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "hygiene",
              "labelling",
              "related_product",
              "contaminants",
              "test_method",
              "sampling",
              "other"
            ]
          },
          "dated": { "type": "boolean" },
          "platformHook": {
            "type": ["string", "null"],
            "description": "Optional platform entity link (e.g. packaging, labelling, hygiene scheme annex)"
          }
        }
      }
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "label"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["GRADE_1", "GRADE_2", "GRADE_3", "UNGRADED"]
          },
          "label": { "type": "string" },
          "isRejectable": {
            "type": "boolean",
            "description": "False for ungraded that is not rejected rice"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "description": "Primarily Table 1 specific requirements plus hooks for contaminants/hygiene",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause", "rules"],
      "properties": {
        "clause": { "type": "string", "const": "8" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" },
              "materialConstraint": {
                "type": "string",
                "enum": ["food_grade", "other"]
              },
              "maxPackageWeightKgHumanHandling": {
                "type": ["number", "null"]
              },
              "destinationWeightsAndMeasures": {
                "type": "boolean",
                "description": "True when destination-country W&M rules apply (clause 7)"
              }
            }
          }
        }
      }
    },
    "labelling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause", "baseStandard", "requiredFields"],
      "properties": {
        "clause": { "type": "string", "const": "9" },
        "baseStandard": { "type": "string", "const": "ARS 56" },
        "requiredFields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fieldId", "label", "required"],
            "properties": {
              "fieldId": { "type": "string" },
              "label": { "type": "string" },
              "required": { "type": "boolean" },
              "allowedValues": {
                "type": "array",
                "items": { "type": "string" }
              },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause", "method"],
      "properties": {
        "clause": { "type": "string", "const": "10" },
        "method": { "type": "string", "const": "ISO 24333" },
        "methodId": { "type": "string" }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Hash of the canonical machine document payload"
    },
    "jsonLdContext": {
      "type": "string",
      "format": "uri",
      "description": "Optional JSON-LD context URI for linked-data publication"
    },
    "example": {
      "description": "Embedded sample instance for ARS 464:2022 Table 1 grade limits (informative companion to this schema)",
      "$ref": "#/$defs/sampleInstance"
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "source",
        "characteristic",
        "operator",
        "unit",
        "limitsByGrade",
        "testMethod"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "pattern": "^ARS464-T1-[0-9]{2}$|^ARS464-[A-Z]+-[0-9]+$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clause", "table", "row"],
          "properties": {
            "clause": { "type": "string" },
            "table": { "type": ["string", "null"] },
            "row": { "type": ["integer", "null"] },
            "pageHint": { "type": ["integer", "null"] }
          }
        },
        "characteristic": { "type": "string" },
        "operator": {
          "type": "string",
          "enum": ["<=", "<", "=", ">=", ">", "nil", "comply_with_external"]
        },
        "unit": { "type": "string" },
        "limitsByGrade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "GRADE_1": { "type": ["number", "string", "null"] },
            "GRADE_2": { "type": ["number", "string", "null"] },
            "GRADE_3": { "type": ["number", "string", "null"] },
            "ALL_GRADES": {
              "type": ["number", "string", "null"],
              "description": "Use when Table 1 publishes a single limit across grades"
            }
          }
        },
        "testMethod": {
          "type": "object",
          "additionalProperties": false,
          "required": ["designation"],
          "properties": {
            "designation": { "type": "string" },
            "methodId": { "type": ["string", "null"] },
            "notes": { "type": "string" }
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "physical_grade",
            "moisture",
            "mycotoxin",
            "contaminant",
            "hygiene",
            "packaging",
            "labelling",
            "other"
          ]
        }
      }
    },
    "sampleInstance": {
      "type": "object",
      "description": "Illustrative populated document; not validated as a second root"
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "standard": {
        "designation": "ARS 464",
        "title": {
          "en": "Milled rice — Specification"
