          "pdfMasterUri": "arso://standards/ars-464-2022/en/master.pdf",
          "previewUri": "arso://standards/ars-464-2022/en/preview-cover-scope.pdf",
          "machineDocUri": "arso://standards/ars-464-2022/en/machine.json",
          "rtl": false
