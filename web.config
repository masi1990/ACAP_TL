<?xml version="1.0" encoding="utf-8"?>
<!--
  ACAP Trade sandbox (test-acap.arso-oran.org)
  IIS reverse proxy (URL Rewrite + ARR) to the Next.js process on port 43123.
-->
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <!--
      Do not add system.webServer/proxy here. That section is AppHostOnly, so IIS
      ignored it and rewrote Pesapal's Location onto this host. Host rewrite is
      disabled on the server proxy element in applicationHost.config.
    -->
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment="node_modules" />
        </hiddenSegments>
        <requestLimits maxUrl="65535" maxQueryString="65535" maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="HttpToHttpsRedirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^test-acap\.arso-oran\.org$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <!--
          Next.js only serves public files that existed at build time.
          Preview images and purchase PDFs are written after that, so IIS
          serves them from the public folder. Full-standard rasters live
          under uploads/standards/full and must be included here too.
        -->
        <rule name="ServeRuntimePublicFiles" stopProcessing="true">
          <match url="^(uploads/standards/(preview|full)/.+\.png|artifacts/.+\.pdf)$" />
          <action type="Rewrite" url="public/{R:0}" />
        </rule>
        <rule name="AcapTlProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:43123/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
