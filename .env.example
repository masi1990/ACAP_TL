DATABASE_URL="postgresql://USER@127.0.0.1:5432/acap_tl?schema=public"
OFFLINE_CACHE_SECRET="change-me"

# Pesapal API v3. Live charges use pay.pesapal.com. Demo charges use the sandbox and are not real money.
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# PESAPAL_ENV=live
# PESAPAL_IPN_ID=
# APP_BASE_URL=https://your-public-host

# Google Workspace SMTP. The app password stays in this file only — never commit a real value.
# Workspace must have 2-Step Verification on, and app passwords allowed for SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifications@arso-oran.org
# SMTP_PASS=
# SMTP_FROM=notifications@arso-oran.org
# CRON_SECRET=
